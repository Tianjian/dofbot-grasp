<mujoco model="dofbot_se_grasp">
  <!-- DOFBOT SE (5-DOF + gripper) derived from
       prior/arm_cam_control/dofbot_info/urdf/dofbot.urdf
       Joint origins/rpy/axes/limits are copied verbatim from that URDF;
       geometry is simplified to primitives (the URDF only ships STL meshes). -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.22 0.22 0.22" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <joint damping="0.15" armature="0.01" frictionloss="0.01"/>
    <geom friction="1.0 0.02 0.002" condim="4" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <position kp="40" kv="1.5"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.62 0.64 0.68" rgb2="0.44 0.46 0.50"
             width="512" height="512"/>
    <material name="table_mat" texture="grid" texrepeat="6 6" reflectance="0.05"/>
    <mesh name="base_link_mesh" file="meshes/base_link.STL"/>
    <mesh name="link1_mesh" file="meshes/link1.STL"/>
    <mesh name="link2_mesh" file="meshes/link2.STL"/>
    <mesh name="link3_mesh" file="meshes/link3.STL"/>
    <mesh name="link4_mesh" file="meshes/link4.STL"/>
    <mesh name="link5_mesh" file="meshes/link5.STL"/>
  </asset>

  <worldbody>
    <camera name="overview" pos="0.5200 -0.6200 0.4200" xyaxes="0.631673 0.775235 -0.000000 -0.306652 0.249864 0.918440" fovy="55"/>
    <light pos="0.2 -0.4 0.9" dir="-0.2 0.4 -0.9" directional="true" diffuse="0.40 0.40 0.40"/>
    <light pos="-0.3 0.2 0.7" dir="0.3 -0.2 -0.7" directional="true" diffuse="0.22 0.22 0.22"/>
    <geom name="floor" type="plane" size="0 0 0.01" pos="0 0 -0.02" material="table_mat"/>

    <!-- table top at z = 0 -->
    <body name="table" pos="0 -0.05 -0.01">
      <geom name="table_top" type="box" size="0.24 0.24 0.01" material="table_mat"/>
    </body>

    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.045 0.022" pos="0 0 0.022"
            rgba="0.22 0.23 0.27 0"/>
          <geom name="base_link_visual" type="mesh" mesh="base_link_mesh" group="2" contype="0" conaffinity="0" rgba="0.74 0.74 0.77 1"/>

      <!-- joint1: origin (0,0,0.06605) rpy(-0.010805,0,0) -->
      <body name="link1" pos="0 0 0.06605" quat="0.99998542 -0.00540243 0 0">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-1.5708 1.5708" damping="0.15" armature="0.01"/>
        <geom name="link1_geom" type="cylinder" size="0.028 0.016" pos="0 0 0.016"
              rgba="0.78 0.78 0.80 0"/>
          <geom name="link1_visual" type="mesh" mesh="link1_mesh" group="2" contype="0" conaffinity="0" rgba="0.74 0.74 0.77 1"/>

        <!-- joint2: origin (0,-0.00031873,0.04145) rpy(0,1.5708,0) -->
        <body name="link2" pos="0 -0.00031873 0.04145" quat="0.70710678 0 0.70710678 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-1.5708 1.5708" damping="0.15" armature="0.01"/>
          <geom name="link2_geom" type="box" size="0.0414 0.014 0.014" pos="-0.0414 0 0"
                rgba="0.72 0.72 0.74 0"/>
          <geom name="link2_visual" type="mesh" mesh="link2_mesh" group="2" contype="0" conaffinity="0" rgba="0.74 0.74 0.77 1"/>

          <!-- joint3: origin (-0.08285,0,0) rpy(0,0,0) -->
          <body name="link3" pos="-0.08285 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-1.5708 1.5708" damping="0.15" armature="0.01"/>
            <geom name="link3_geom" type="box" size="0.0414 0.012 0.012" pos="-0.0414 0 0"
                  rgba="0.72 0.72 0.74 0"/>
          <geom name="link3_visual" type="mesh" mesh="link3_mesh" group="2" contype="0" conaffinity="0" rgba="0.74 0.74 0.77 1"/>

            <!-- joint4: origin (-0.08285,0,0) rpy(0,0,0.0083081) -->
            <body name="link4" pos="-0.08285 0 0" quat="0.99999138 0 0 0.00415400">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-1.5708 1.5708" damping="0.15" armature="0.01"/>
              <geom name="link4_geom" type="box" size="0.0369 0.011 0.011" pos="-0.0369 0 0"
                    rgba="0.72 0.72 0.74 0"/>
          <geom name="link4_visual" type="mesh" mesh="link4_mesh" group="2" contype="0" conaffinity="0" rgba="0.74 0.74 0.77 1"/>

              <!-- joint5: origin (-0.07385,-0.001,0) rpy(0,-1.57,0) -->
              <!-- wrist camera: on the forearm (link4), as on the real arm, so the
                   j5 gripper-base rotation turns the jaws without turning the view -->
              <camera name="wrist_cam" pos="-0.05840 -0.0576 -0.0007" quat="0 0.70710678 0 0.70710678" fovy="90"/>

              <body name="link5" pos="-0.07385 -0.001 0" quat="0.70710678 0 -0.70710678 0">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-2.3562 2.3562"/>
                <geom name="link5_geom" type="box" size="0.010 0.020 0.012" pos="0 0 0.012"
                      rgba="0.45 0.47 0.52 1"/>
                <geom name="gripper_base" type="box" size="0.010 0.021 0.010" pos="0 0 0.030"
                      rgba="0.35 0.37 0.42 1"/>

                <!-- wrist camera: mounted beside the gripper, looking along +Z (down the tool axis) -->
                <site name="tcp" pos="0 0 0.050" size="0.002" rgba="0 0 0 0"/>

                <!-- Two fingers, as in the official DOFBOT-SE URDF: each is a
                     *revolute* joint and the second mimics the first with multiplier
                     -1, so one servo (j6) drives both.  Geometry from link5.STL: the
                     plates are 21.3 x 3.0 x 47.9 mm, pivoting at z = 40 mm, tips at
                     z = 88 mm.  A 8 deg swing moves each tip 6.7 mm inward, taking the
                     inner faces from +-20.45 mm to +-13.7 mm -- a 30 mm cube is clamped
                     with 1.3 mm of interference. -->
                <body name="finger_left" pos="-0.0311 0 0.040">
                  <joint name="gripper_left" type="hinge" axis="0 1 0" range="0 0.16"/>
                  <geom name="finger_left_geom" type="box" size="0.01065 0.0015 0.024"
                        pos="0 0 0.024" friction="1.4 0.02 0.002" rgba="0.30 0.32 0.36 1"/>
                </body>
                <body name="finger_right" pos="0.0311 0 0.040">
                  <joint name="gripper_right" type="hinge" axis="0 1 0" range="-0.16 0"/>
                  <geom name="finger_right_geom" type="box" size="0.01065 0.0015 0.024"
                        pos="0 0 0.024" friction="1.4 0.02 0.002" rgba="0.30 0.32 0.36 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <!-- 30 mm cube (target) -->
    <body name="cube" pos="-0.009 -0.162 0.015">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.02"
            rgba="0.62 0.42 0.22 1"/>
    </body>

  </worldbody>

  <actuator>
    <position name="act_joint1" joint="joint1" kp="18" forcerange="-6 6" ctrlrange="-1.5708 1.5708"/>
    <position name="act_joint2" joint="joint2" kp="18" forcerange="-6 6" ctrlrange="-1.5708 1.5708"/>
    <position name="act_joint3" joint="joint3" kp="18" forcerange="-6 6" ctrlrange="-1.5708 1.5708"/>
    <position name="act_joint4" joint="joint4" kp="18" forcerange="-6 6" ctrlrange="-1.5708 1.5708"/>
    <position name="act_joint5" joint="joint5" kp="20" forcerange="-3 3" ctrlrange="-2.3562 2.3562"/>
    <position name="act_gripper" joint="gripper_left" kp="120" forcerange="-6 6" ctrlrange="0 0.16"/>
  </actuator>

  <equality>
    <!-- URDF ``mimic joint="Rlink1_Joint" multiplier="-1"``: one servo drives both jaws -->
    <joint joint1="gripper_right" joint2="gripper_left" polycoef="0 -1 0 0 0"/>
  </equality>
</mujoco>
